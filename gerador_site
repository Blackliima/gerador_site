import os
import requests
from jinja2 import Template

# 1. Configuração dos Anúncios (Cole seus códigos reais da Adsterra ou AdSense aqui quando quiser)
AD_BANNER_HEADER = """
<div style="text-align:center; margin: 20px 0; background:#f4f4f4; padding:10px; border-radius:8px;">
    <!-- COLE SEU CÓDIGO DA ADSTERRA / ADSENSE AQUI -->
    <p style="color:#777; font-size:12px;">[Espaço para Anúncio - Banner]</p>
</div>
"""

# 2. Template HTML Moderno, Responsivo e Otimizado para SEO
HTML_TEMPLATE = """
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ country.name }} - Dados, Moeda e População</title>
    <meta name="description" content="Confira dados atualizados sobre {{ country.name }}, incluindo capital, população, moeda oficial, fuso horário e idioma.">
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.6; color: #333; max-width: 800px; margin: 0 auto; padding: 20px; background: #f9f9f9; }
        .card { background: #fff; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        h1 { color: #1a73e8; margin-top: 0; }
        ul { list-style: none; padding: 0; }
        li { padding: 10px 0; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; }
        .label { font-weight: bold; color: #555; }
        .footer { text-align: center; margin-top: 30px; font-size: 13px; color: #888; }
    </style>
</head>
<body>

    {{ ad_code | safe }}

    <div class="card">
        <h1>{{ country.name }}</h1>
        <p>Informações estatísticas e dados gerais obtidos em tempo real de APIs públicas.</p>
        
        <ul>
            <li><span class="label">Capital:</span> <span>{{ country.capital }}</span></li>
            <li><span class="label">Região / Continente:</span> <span>{{ country.region }}</span></li>
            <li><span class="label">População Estimada:</span> <span>{{ country.population }} habitantes</span></li>
            <li><span class="label">Moeda Oficial:</span> <span>{{ country.currency }}</span></li>
            <li><span class="label">Fuso Horário:</span> <span>{{ country.timezone }}</span></li>
        </ul>
    </div>

    {{ ad_code | safe }}

    <div class="footer">
        <p>© 2026 Guia de Dados Globais. Gerado automaticamente via Python.</p>
    </div>

</body>
</html>
"""

def baixar_dados():
    print("Buscando dados na API pública gratuita...")
    url = "https://restcountries.com/v3.1/all"
    response = requests.get(url)
    if response.status_code == 200:
        return response.json()
    else:
        print("Erro ao acessar a API.")
        return []

def gerar_site():
    dados = baixar_dados()
    if not dados:
        return

    # Cria a pasta de saída para as páginas HTML
    output_dir = "output"
    os.makedirs(output_dir, exist_ok=True)

    template = Template(HTML_TEMPLATE)
    contador = 0

    for item in dados:
        try:
            # Tratamento seguro dos dados da API
            name = item.get('name', {}).get('common', 'Desconhecido')
            capital = item.get('capital', ['N/A'])[0]
            region = item.get('region', 'N/A')
            population = f"{item.get('population', 0):,}".replace(',', '.')
            
            currencies = item.get('currencies', {})
            currency_name = list(currencies.values())[0]['name'] if currencies else 'N/A'
            
            timezone = item.get('timezones', ['N/A'])[0]

            country_data = {
                "name": name,
                "capital": capital,
                "region": region,
                "population": population,
                "currency": currency_name,
                "timezone": timezone
            }

            # Renderiza o HTML específico para este país
            html_content = template.render(country=country_data, ad_code=AD_BANNER_HEADER)

            # Cria um nome de arquivo limpo baseado no nome do país
            file_name = name.lower().replace(' ', '-').replace('(', '').replace(')', '') + ".html"
            file_path = os.path.join(output_dir, file_name)

            with open(file_path, "w", encoding="utf-8") as f:
                f.write(html_content)

            contador += 1
        except Exception as e:
            continue

    print(f"Sucesso! {contador} páginas estáticas geradas na pasta '{output_dir}/'.")

if __name__ == "__main__":
    gerar_site()

